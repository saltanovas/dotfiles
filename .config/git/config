[user]
    name = saltanovas
    email = zumbass@gmail.com

[core]
    pager = delta

[fetch]
    prune = true

[push]
    autoSetupRemote = true

[rebase]
    autoStash = true

[rerere]
    enabled = true

[include]
    path = ~/.config/delta/config

[includeIf "hasconfig:remote.*.url:git@github.com:telia-*/**"]
    path = ~/.config/git/work.telia.conf
