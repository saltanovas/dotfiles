{
    "update.mode": "start",
    "security.workspace.trust.enabled": false,

    "workbench.startupEditor": "newUntitledFile",
    "workbench.activityBar.location": "top",
    "workbench.sideBar.location": "left",
    "workbench.tree.indent": 19,
    "workbench.tree.renderIndentGuides": "always",
    "explorer.autoReveal": false, // Navigates to the file in the explorer when opened
    "explorer.compactFolders": true,
    "breadcrumbs.enabled": false,

    "editor.scrollbar.horizontal": "auto",
    "editor.scrollbar.vertical": "auto",
    "editor.scrollbar.verticalScrollbarSize": 8,
    "editor.scrollbar.horizontalScrollbarSize": 8,
    "editor.overviewRulerBorder": false, // Border on the scrollbar
    "editor.smoothScrolling": true,
    "editor.scrollBeyondLastLine": false,
    "editor.stickyScroll.enabled": true,
    "editor.cursorBlinking": "phase",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.minimap.enabled": false,

    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "editor.fontSize": 13,
    "editor.lineHeight": 24,
    "window.zoomLevel": -0.2,
    "editor.lineDecorationsWidth": 0, // Width between line numbers and code. Unofficial, yet works
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "editor.insertSpaces": true, // Use spaces as indentation instead of tabs
    "editor.renderControlCharacters": true,
    "editor.renderFinalNewline": "on",
    "editor.fontLigatures": false, // e.g. != is shown as ≠
    "editor.semanticHighlighting.enabled": true,
    "editor.bracketPairColorization.enabled": false,
    "editor.matchBrackets": "near",
    "editor.foldingHighlight": false, // Highlight the folded code

    // Formatters
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "[c][cpp]": { "editor.defaultFormatter": "ms-vscode.cpptools" },
    "[go]": { "editor.defaultFormatter": "golang.go" },
    "[java]": { "editor.defaultFormatter": "redhat.java" },
    "[php]": { "editor.defaultFormatter": "bmewburn.vscode-intelephense-client" },
    "[properties]": { "editor.defaultFormatter": "lumirelle.shell-format-rev" },
    "[shellscript]": { "editor.defaultFormatter": "lumirelle.shell-format-rev" },
    "[toml]": { "editor.defaultFormatter": "tamasfe.even-better-toml" },
    "[xml]": { "editor.defaultFormatter": "redhat.vscode-xml" },
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.plist": "binaryPlistEditor.edit"
    },
    "files.associations": {
        ".zprofile": "shellscript",
        ".zshenv": "shellscript",
        ".zshrc": "shellscript",
        "Brewfile*": "shellscript",
        "*.conf": "properties"
    },

    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
    "terminal.integrated.fontSize": 12,

    "git.autofetch": true,
    "git.confirmSync": false,
    "git.blame.editorDecoration.enabled": true,

    "chat.viewSessions.orientation": "stacked",
    "chat.tools.terminal.autoApprove": {
        "awk": true,
        "basename": true,
        "cmp": true,
        "command": true,
        "continue": true,
        "defaults": true,
        "delta": true,
        "df": true,
        "diff": true,
        "dirname": true,
        "du": true,
        "fd": true,
        "file": true,
        "jar": true,
        "javap": true,
        "jq": true,
        "plutil": true,
        "printf": true,
        "read": true,
        "realpath": true,
        "rg": true,
        "stat": true,
        "strings": true,
        "tee": true,
        "tr": true,
        "true": true,
        "uniq": true,
        "unzip": true,
        "which": true,
        "zipinfo": true
    },

    // ── Java: code lenses ───────────────────────────────────────────────
    "java.referencesCodeLens.enabled": true, // "N references" above declarations
    "java.implementationCodeLens": "all", // "N implementations" on interfaces and methods
    // ── Java: inlay hints ───────────────────────────────────────────────
    "java.inlayHints.variableTypes.enabled": false, // type behind `var`
    "java.inlayHints.parameterTypes.enabled": true, // lambda parameter types
    "java.inlayHints.parameterNames.enabled": "all", // parameter names at call sites
    "java.inlayHints.parameterNames.exclusions": [
        "*.List.of",
        "*.Set.of",
        "*.Map.of",
        "org.slf4j.Logger.*",
        "java.lang.Math.*"
    ],
    // ── Java: on save ───────────────────────────────────────────────────
    "editor.codeActionsOnSave": { "source.organizeImports": "explicit" },
    "java.sources.organizeImports.starThreshold": 99, // never collapse to wildcard imports
    "java.cleanup.actions": [
        "renameFileToType",
        "addOverride",
        "instanceofPatternMatch",
        "lambdaExpressionFromAnonymousClass",
        "switchExpression",
        "tryWithResource",
        "stringConcatToTextBlock",
        "redundantModifiers"
    ],
    // ── Java: build & dependencies ──────────────────────────────────────
    "java.configuration.updateBuildConfiguration": "automatic", // reload pom/gradle changes without asking
    "java.maven.downloadSources": true, // real sources when jumping into libraries

    "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-dark",
    "workbench.productIconTheme": "icons-carbon",
    "workbench.colorTheme": "Aivaras Darcula IntelliJ",
    "workbench.colorCustomizations": {},
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": []
    }
}
